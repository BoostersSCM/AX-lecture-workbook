{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build-env.js",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.js": { "includeFiles": "public/js/content.js" }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/env.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
